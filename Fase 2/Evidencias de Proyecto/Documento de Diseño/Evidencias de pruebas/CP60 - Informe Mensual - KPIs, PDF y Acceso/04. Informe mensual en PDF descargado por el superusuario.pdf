<!-- src/templates/base.html -->

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar Sesión - LifeBetter</title>

    <!-- Bootstrap 5 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Hojas de Estilo Desacopladas -->
    <link rel="stylesheet" href="/static/css/custom.css?v=1795206209">
    <link rel="stylesheet" href="/static/css/sidebar.css?v=1795206209">
    <link rel="stylesheet" href="/static/css/navbar_residente.css?v=1795206209">
    <link rel="stylesheet" href="/static/css/notifications.css?v=1795206209">
    <link rel="stylesheet" href="/static/css/assistant_bot.css?v=1795206209">
    
</head>
<body class="bg-light">

    <div class="d-flex min-vh-100">
        <!-- Única Barra Lateral para Admin y Conserje -->
        

        <!-- Contenedor Principal -->
        <div class="flex-grow-1 d-flex flex-column min-w-0">
            
                <!-- Barra Superior para Residente y Visitantes -->
                <nav class="navbar navbar-expand-xl navbar-dark lb-top-navbar shadow-sm">
    <div class="container-fluid px-4">
        <a class="navbar-brand d-flex align-items-center" href="/">
            <i class="bi bi-building-check text-success fs-4 me-2"></i>
            <span>LifeBetter AIoT</span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#residenteNavbar" aria-controls="residenteNavbar" aria-expanded="false" aria-label="Alternar navegación">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="residenteNavbar">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                
                    
                    <li class="nav-item"><a class="nav-link" href="/#inicio">Inicio</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#servicios">Servicios</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#nosotros">Nosotros</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#planes">Planes</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#opiniones">Opiniones</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#contacto">Contáctanos</a></li>
                
            </ul>

            <div class="d-flex align-items-center gap-2">
                
                    <a href="/#contacto" class="btn btn-outline-light btn-sm d-none d-sm-inline-block">Solicitar demo</a>
                    <a href="/login/" class="btn btn-success btn-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                    </a>
                
            </div>
        </div>
    </div>
</nav>
            

            

            <main class="container-fluid p-4 flex-grow-1">
                
<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <div class="card custom-card">
            <div class="card-body p-4 p-sm-5">
                <h3 class="card-title text-center mb-4 text-primary-custom fw-bold">
                    <i class="bi bi-building-check"></i> LifeBetter
                </h3>
                
                

                <form method="POST">
                    <input type="hidden" name="csrfmiddlewaretoken" value="iJteTQdQw5jub5D6OiiKE09vpTEF7R2qm10LJG6dtE09wmyxS6UYFghxB5mBNmI2">
                    <div class="mb-3">
                        <label for="id_username" class="form-label">Correo Electrónico</label>
                        <input type="email" name="username" class="form-control" id="id_username" placeholder="ejemplo@lifebetter.cl" autocomplete="username" required autofocus>
                    </div>
                    <div class="mb-4">
                        <label for="id_password" class="form-label">Contraseña</label>
                        <input type="password" name="password" class="form-control" id="id_password" placeholder="••••••••" autocomplete="current-password" required>
                    </div>
                    <button type="submit" class="btn btn-primary-custom w-100 py-2 fw-bold">Iniciar Sesión</button>
                </form>
                <div class="text-center mt-3">
                    <a href="/recuperar-clave/" class="small">¿Olvidaste tu contraseña?</a>
                </div>

                <!-- Panel de Carga Rápida -->
                <div class="mt-4 pt-3 border-top text-center">
                    <small class="text-muted d-block mb-2">⚡ Atajos de Prueba (Desarrollo Local)</small>
                    <div class="btn-group w-100" role="group">
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="fillCredentials('residente@lifebetter.cl')">Residente</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="fillCredentials('conserje@lifebetter.cl')">Conserje</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="fillCredentials('admin@lifebetter.cl')">Admin</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

            </main>
        </div>
    </div>

    


    <!-- Scripts Desacoplados -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/static/js/sidebar.js?v=1795206209"></script>
    <script src="/static/js/notifications.js?v=1795206209"></script>
    <script src="/static/js/assistant_bot.js?v=1795206209"></script>
    
<script src="/static/js/login.js"></script>

</body>
</html>